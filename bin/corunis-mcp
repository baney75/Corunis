#!/usr/bin/env python3
"""Launcher named by plugin.toml: runs the Corunis brain MCP server over stdio."""

import sys
from pathlib import Path

if sys.version_info < (3, 11):
    sys.exit("corunis-mcp needs Python 3.11 or newer")

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "server"))

from corunis_mcp.server import main  # noqa: E402

sys.exit(main())
